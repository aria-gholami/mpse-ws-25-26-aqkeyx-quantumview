FROM composer:2.9.4 AS composer
WORKDIR /app
COPY composer.json composer.lock ./
COPY packages ./packages
RUN install-php-extensions intl zip
RUN composer install --no-interaction --optimize-autoloader --no-scripts --no-dev

FROM node:24-alpine AS node
WORKDIR /app
COPY . .
COPY --from=composer /app/vendor /app/vendor
RUN cd assets/admin/ && npm ci --no-color
RUN cd assets/admin/ && npm run build

FROM dunglas/frankenphp:php8.4-alpine
WORKDIR /var/www/cms
COPY . .
COPY Caddyfile.prod /etc/caddy/Caddyfile
COPY --from=composer /app/vendor /var/www/cms/vendor
COPY --from=node /app/public/build /var/www/cms/public/build
RUN install-php-extensions \
    pdo_mysql \
    gd \
    intl \
    zip \
    opcache \
    exif \
    bcmath \
    imagick \
    xml

EXPOSE 8001

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
